# Copie este archivo como ".env" para personalizar la ejecución (opcional).
# Todas las variables tienen un valor por defecto; el archivo .env NO se sube a Git.

# Puerto del servidor HTTP (también puede pasarse como argumento: python backend/server.py 8080)
PORT=8000

# Ruta del archivo SQLite. Por defecto: ./data/rescata.db
# RESCATA_DB=./data/rescata.db

# Modo demostración: 1 = la pantalla de ingreso lista las cuentas de ejemplo; 0 = las oculta (recomendado fuera de clases)
RESCATA_DEMO=1

# Contraseña inicial de las cuentas de demostración (solo se usa al crear las cuentas; cámbiela desde la aplicación)
RESCATA_DEMO_PASSWORD=CambieEstaClave2026

# Registro de peticiones HTTP en consola (vacío = desactivado)
# RESCATA_VERBOSE=1
